"Not enough data to establish baseline. Wear your Apple Watch for at least 20 days." = "数据不足，无法建立基准值。请佩戴 Apple Watch 至少20天。";

/* Authorization */
"Welcome to HRV Run" = "欢迎使用 HRV Run";
"This app analyzes your Heart Rate Variability (HRV) to provide personalized running recommendations." = "此应用通过分析你的心率变异性（HRV）来提供个性化的跑步建议。";
"We need access to your Health data to:" = "我们需要访问你的健康数据以便：";
"Read your HRV data" = "读取你的 HRV 数据";
"Read your workout history" = "读取你的锻炼历史";
"Save your workout data" = "保存你的锻炼数据";
"Your data stays on your device and is never uploaded to any server." = "你的数据保留在设备上，绝不会上传到任何服务器。";
"Grant Access" = "授予访问权限";

/* Charts */
"7-Day Trend" = "7天趋势";
"30-Day Trend" = "30天趋势";
"Low Zone" = "低区间";
"Normal Zone" = "正常区间";
"High Zone" = "高区间";

/* Notifications */
"Excellent Recovery!" = "恢复极佳！";
"Good Recovery" = "恢复良好";
"Moderate Recovery" = "恢复一般";
"Low Recovery" = "恢复较差";
"Rest Needed" = "需要休息";
"Today's Training Recommendation" = "今日训练建议";
"Great Workout!" = "训练效果极佳！";
"Good Workout" = "训练效果良好";
"Moderate Workout" = "训练效果一般";
"Challenging Workout" = "训练强度较大";
"Your HRV is recovering well. Excellent training session!" = "你的HRV恢复良好。这次训练效果极佳！";
"Your HRV is recovering normally. Good job!" = "你的HRV恢复正常。训练不错！";
"Your HRV dropped more than usual. Consider easier training tomorrow." = "你的HRV下降幅度较大。建议明天降低训练强度。";
"Your HRV dropped significantly. Make sure to rest and recover properly." = "你的HRV显著下降。请确保充分休息和恢复。";

/* Explanations */
"What is this?" = "这是什么？";
"Understanding the Ranges" = "理解数据范围";
"Excellent" = "优秀";
"Good" = "良好";
"Needs Attention" = "需要注意";
"Recommendations" = "建议";
"Done" = "完成";

/* Recovery Score Explanation */
"Recovery Score Explanation" = "恢复评分说明";
"Recovery Score Description" = "你的恢复评分(0-100)基于当前HRV与个人基准的对比，反映了身体对训练的准备程度。";
"Excellent recovery. Your body is fully recovered and ready for high-intensity training." = "恢复极佳。身体已完全恢复，可以进行高强度训练。";
"Good recovery. Suitable for moderate training as planned." = "恢复良好。适合按计划进行中等强度训练。";
"Below optimal. Your body needs more rest. Consider light exercise or rest day." = "低于最佳状态。身体需要更多休息。考虑轻度锻炼或休息日。";
"85-100: High-intensity training, intervals, tempo runs" = "85-100：高强度训练、间歇跑、节奏跑";
"70-84: Moderate training, easy runs, steady pace" = "70-84：中等强度训练、轻松跑、稳定配速";
"50-69: Light exercise, recovery runs, walking" = "50-69：轻度锻炼、恢复跑、步行";
"0-49: Rest or very light activity recommended" = "0-49：建议休息或非常轻度的活动";

/* HRV Status Explanation */
"HRV Status Explanation" = "HRV状态说明";
"HRV Status Description" = "HRV（心率变异性）测量心跳之间的时间变化。数值越高通常表示恢复越好，准备度越高。";
"Above Baseline + 1SD" = "高于基准+1个标准差";
"High Zone: Excellent recovery, body is well-rested and ready for intense training." = "高区间：恢复极佳，身体休息充分，可进行高强度训练。";
"Baseline ± 1SD" = "基准±1个标准差";
"Normal Zone: Good recovery, suitable for regular training." = "正常区间：恢复良好，适合常规训练。";
"Below Baseline - 1SD" = "低于基准-1个标准差";
"Low Zone: Body needs rest, avoid high-intensity training." = "低区间：身体需要休息，避免高强度训练。";
"High Zone: Great time for challenging workouts, PRs, hard sessions" = "高区间：挑战性训练、刷新个人最好成绩、高强度课程的好时机";
"Normal Zone: Proceed with planned training, maintain consistency" = "正常区间：按计划训练，保持一致性";
"Low Zone: Focus on recovery, sleep 8+ hours, stay hydrated" = "低区间：专注恢复，睡眠8小时以上，保持水分";

/* Trend Explanation */
"Trend Explanation" = "趋势说明";
"Trend Description" = "你的HRV趋势显示了恢复状况随时间的变化，有助于识别进步或累积疲劳的模式。";
"Improving (↑)" = "上升 (↑)";
"Your HRV is trending upward, indicating improving recovery and adaptation to training." = "你的HRV呈上升趋势，表明恢复改善，对训练适应良好。";
"Stable (→)" = "稳定 (→)";
"Your HRV is stable, indicating consistent recovery status." = "你的HRV保持稳定，表明恢复状态一致。";
"Declining (↓)" = "下降 (↓)";
"Your HRV is trending downward, may indicate accumulated fatigue or overtraining." = "你的HRV呈下降趋势，可能表明累积疲劳或过度训练。";
"Improving: Good sign! You can maintain or slightly increase training load" = "上升：好兆头！可以保持或略微增加训练量";
"Stable: Maintain current training and recovery balance" = "稳定：保持当前训练和恢复的平衡";
"Declining: Warning sign! Add rest days, reduce intensity, focus on recovery" = "下降：警告信号！增加休息日，降低强度，专注恢复";
"Monitor for 3-5 days before making major training changes" = "观察3-5天后再做重大训练调整";

/* Chart Explanation */
"HRV Chart Explanation" = "HRV图表说明";
"HRV Chart Description" = "此图表显示了过去7天的HRV测量值，并与你的个人基准和阈值进行对比。";
"Above Green Line" = "绿线以上";
"Data points above the high threshold indicate excellent recovery days." = "高于高阈值的数据点表示恢复极佳的日子。";
"Between Green and Red Lines" = "绿线与红线之间";
"Data points in normal range indicate typical recovery status." = "正常范围内的数据点表示典型的恢复状态。";
"Below Red Line" = "红线以下";
"Data points below low threshold indicate need for recovery." = "低于低阈值的数据点表示需要恢复。";
"Blue Dashed Line: Your personal baseline (average)" = "蓝色虚线：你的个人基准（平均值）";
"Green Dashed Line: High threshold (baseline + 1SD)" = "绿色虚线：高阈值（基准+1个标准差）";
"Red Dashed Line: Low threshold (baseline - 1SD)" = "红色虚线：低阈值（基准-1个标准差）";
"Purple Line: Your actual HRV measurements over time" = "紫色实线：你的实际HRV测量值";
"Look for patterns: consistent highs, lows, or fluctuations" = "寻找模式：持续的高点、低点或波动";


